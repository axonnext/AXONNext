#!/usr/bin/env python
from __future__ import print_function, unicode_literals

from axon2.utils import json2axon
import sys

if __name__ == '__main__':
    if len(sys.argv) == 2:
        from_file = sys.argv[1]
        print(json2axon(from_file))
    elif len(sys.argv) == 3:
        from_file, to_file = sys.argv[1], sys.argv[2]
        json2axon(from_file, to_file)
    else:
        print('Usage: json2axon <from_file> [to_file]', file=sys.stderr)
        sys.exit(2)
        
